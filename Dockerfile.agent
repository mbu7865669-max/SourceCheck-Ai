# syntax=docker/dockerfile:1
# =============================================================================
# SourceCheck AI - agent image
#
# Runs the retrieval -> verification -> reasoning pipeline as its own service
# (`uvicorn agent_service:app` on :8001). The port is deliberately NOT published
# to the host: only the web gateway (and other compose services) reach it.
# Model routing comes from MODEL_PROVIDER; with `opencode` the container talks
# to the bridge service declared in docker-compose.yml.
#
# Same source tree as the web image (Dockerfile) - only the entrypoint and the
# exposed port differ.
# =============================================================================
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    HOST=0.0.0.0 \
    PORT=8001

WORKDIR /app

# Dependencies first so source-only edits reuse the layer.
COPY requirements.txt ./
RUN pip install -r requirements.txt

# Application code. `tests/` ships in the image on purpose so the pipeline can
# be verified against the exact bytes that run in production.
COPY main.py agent_service.py ./
COPY app ./app
COPY bridge ./bridge
COPY tests ./tests

# Unprivileged service account: the code never writes to disk, so root buys nothing.
RUN useradd --system --no-create-home --uid 10001 app
USER app

EXPOSE 8001

# Liveness probe on /livez (no bridge probe: the bridge has its own healthcheck).
# This is what docker compose's `depends_on: condition: service_healthy` gates on.
HEALTHCHECK --interval=15s --timeout=5s --start-period=25s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8001/livez', timeout=4).status == 200 else 1)"

CMD ["python", "agent_service.py"]
